# Custom headscale build that substitutes VM_PUBLIC_DOMAIN into
# config.yaml.template at container start (Node C, OpenVPN/Headscale/
# connectivity task). The official headscale/headscale image has no
# built-in templating — its config.yaml is a static file — but this app
# only knows the real public domain at runtime (an AppSetting, resolved by
# POST /api/admin/settings/domain/apply), the same reason
# pbx_configs/generated/Caddyfile is written by that route rather than
# hardcoded. Mirrors this repo's own Dockerfile.caddy pattern (customize a
# stock image with a small build/entrypoint step) rather than inventing a
# new approach.
#
# NOT verified against a live build in this environment — must be built on
# the deployment VM before being trusted, same caveat Dockerfile.caddy's
# own header carries.
FROM headscale/headscale:0.23.0

RUN apk add --no-cache gettext

COPY pbx_configs/headscale/config.yaml.template /etc/headscale/config.yaml.template
COPY pbx_configs/headscale/docker-entrypoint.sh /docker-entrypoint-headscale.sh
RUN chmod +x /docker-entrypoint-headscale.sh

ENTRYPOINT ["/docker-entrypoint-headscale.sh"]
CMD ["headscale", "serve"]
