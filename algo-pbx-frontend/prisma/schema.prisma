// Algo PBX data model.
// ORM decision (was open in LLM.md): Prisma, for schema-migration ergonomics
// and typed client generation used by src/lib/db.ts and the API routes.

generator client {
  provider      = "prisma-client-js"
  // Explicit, not "native": Prisma 5.22's OpenSSL auto-detection doesn't
  // recognize Alpine 3.23's OpenSSL 3.x (the runner stage's base image,
  // node:20-alpine) and silently falls back to an openssl-1.1.x engine
  // binary — which then fails at runtime with "Could not parse schema
  // engine response" because no libssl 1.1 compat lib exists on that
  // image. "native" is also kept so `npx prisma generate`/tests on a
  // developer's own machine (Windows/macOS/glibc Linux) keep working
  // unchanged.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AgentStatus {
  AVAILABLE
  BUSY
  BREAK
  OFFLINE
}

// Loop C2 — toll-fraud guard. Before this, the outbound dialplan
// ([from-agent] in pbx_configs/extensions.conf) matched a bare `_X.` —
// ANY number, no restriction — reachable by any agent whose SIP secret
// (held in browser memory) leaked. Defaults to LOCAL (safe by default);
// an admin must explicitly widen an extension's reach.
enum DialPermission {
  LOCAL
  NATIONAL
  INTERNATIONAL
}

enum Role {
  AGENT
  SUPERVISOR
  ADMIN
}

// =========================================
// MULTI-TENANT SAAS FOUNDATION — WAVE 1 (2026-09-04)
// D1: one pooled stack, namespaced. `Tenant` is the top-level customer
// record; every customer-owned model below gets a `tenantId`. Our current
// single deployment becomes tenant #1 (slug "sahara") via the migration's
// step 1 insert — see prisma/migrations/<ts>_add_tenancy/migration.sql.
// D2: `PlatformUser` is a SEPARATE table with NO tenantId, by construction —
// a tenant-scoped Prisma query can never return one. Reserved-slug list and
// slug-format validation live in src/lib/tenant/slug.ts (validation code,
// not the schema — see plan §1 amendment), not enforced here.
// =========================================

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  OFFBOARDED
}

enum BillingStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
}

enum PlatformRole {
  PLATFORM_OWNER
  PLATFORM_SUPPORT
}

model Tenant {
  id     String       @id @default(cuid())
  // DNS-safe, lowercase, unique — validated at creation (src/lib/tenant/slug.ts,
  // including the reserved-word list), immutable after. Allocates
  // <slug>.algopbx.com under the wildcard cert (plan §6).
  slug   String       @unique
  name   String
  status TenantStatus @default(TRIAL)

  // --- Billing: manual-first, owner-overridable (plan §5 / Requirement B) ---
  plan            String        @default("standard")
  seats           Int           @default(5)
  billingStatus   BillingStatus @default(TRIAL)
  paidUntil       DateTime?
  // Set when a gateway/processor is added later; null = manual invoicing.
  billingRef      String?
  billingProvider String?

  // --- Provisioning (plan §4) ---
  // Allocated /24 index: tenant n owns 10.8.n.0/24. Unique, never reused
  // even after offboarding, so a stale gateway can never land in a live
  // tenant's subnet.
  tunnelSubnetIndex Int? @unique

  // --- Back-relations: every customer-owned model in this schema ---
  users                   User[]
  extensions              Extension[]
  queues                  Queue[]
  queueMembers            QueueMember[]
  callDetailRecords       CallDetailRecord[]
  recordings              Recording[]
  auditLogs               AuditLog[]
  callQualitySamples      CallQualitySample[]
  doNotCallEntries        DoNotCallEntry[]
  invites                 Invite[]
  otpChallenges           OtpChallenge[]
  trustedDevices          TrustedDevice[]
  loginAttempts           LoginAttempt[]
  escalationTargets       EscalationTarget[]
  escalationAttempts      EscalationAttempt[]
  waInstances             WaInstance[]
  contacts                Contact[]
  contactTransferRequests ContactTransferRequest[]
  contactNotes            ContactNote[]
  contactTasks            ContactTask[]
  callDispositions        CallDisposition[]
  companies               Company[]
  deals                   Deal[]
  dealNotes               DealNote[]
  activities              Activity[]
  conversations           Conversation[]
  chatMessages            ChatMessage[]
  smsAccessRequests       SmsAccessRequest[]
  rooms                   Room[]
  webhookSubscriptions    WebhookSubscription[]
  apiKeys                 ApiKey[]
  gatewaySites            GatewaySite[]
  gatewayEvents           GatewayEvent[]
  pipelineStages          PipelineStage[]
  appSettings             AppSetting[]
  supportGrants           SupportGrant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([billingStatus, paidUntil])
}

// D2: no tenantId, by construction. A tenant-scoped query cannot return one.
model PlatformUser {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String
  role         PlatformRole @default(PLATFORM_SUPPORT)
  // 2FA is mandatory, not optional — a row with totpSecret null may not
  // complete login (enforced in the /platform authorize path, not just UI).
  totpSecret      String?
  totpConfirmedAt DateTime?
  disabled        Boolean        @default(false)
  grants          SupportGrant[]
  createdAt       DateTime       @default(now())
}

// Time-boxed, reasoned, dual-logged support access. Absence of a live row
// here means a PLATFORM_SUPPORT user gets nothing from a tenant scope.
model SupportGrant {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  platformUserId String
  platformUser   PlatformUser @relation(fields: [platformUserId], references: [id])
  reason         String // mandatory, free text, shown to the tenant
  grantedAt      DateTime     @default(now())
  expiresAt      DateTime // hard stop; no open-ended grants
  revokedAt      DateTime?

  @@index([tenantId, expiresAt])
  @@index([platformUserId])
}

// Platform-plane audit. Deliberately NOT the same table as the tenant
// AuditLog: that one's actorId is a required FK to User, and a platform
// actor is not a User. See plan §6.
model PlatformAuditLog {
  id             String   @id @default(cuid())
  action         String // "tenant.provision" | "billing.mark_paid" | ...
  platformUserId String?
  tenantId       String? // which tenant this action was about
  // MANDATORY for every destructive/consequential platform action — not
  // billing overrides alone: suspend, offboard, dialplan cut, plan/seat
  // change, and support-grant creation all require one. Enforced at the
  // API layer (rejects empty/whitespace), not just in the form.
  reason    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([action])
}

model User {
  id                             String                   @id @default(cuid())
  // Tenant is derived from this row, NOT from the request host — see
  // schema-level comment on Tenant above and the host-vs-user mismatch rule
  // (plan §1). email/phoneE164 stay GLOBALLY unique, deliberately: one
  // person cannot belong to two tenants (Requirement A continuity — see
  // plan's "email uniqueness decision").
  tenantId                       String
  tenant                         Tenant                   @relation(fields: [tenantId], references: [id])
  email                          String                   @unique
  // Nullable now: an admin-created user starts with NO password at all
  // (Workstream D) — Invite.tokenHash is the only way to set one, once,
  // via the Resend-delivered link. A row with passwordHash null AND no
  // pending unconsumed Invite is an account that was created but never
  // completed onboarding; the login path (src/auth.ts) must treat null
  // the same as "credentials can never match", not as an open door.
  passwordHash                   String?
  // Owner override (2026-08-29): the operator wants agent passwords
  // readable from the admin panel to recover locked-out agents without a
  // reset round-trip. Kept in sync with passwordHash at every write site
  // (setup, invite consume, admin create, admin PATCH, self-service
  // reset). Returned by GET /api/admin/users for ADMIN sessions only.
  // This deliberately breaks the original "an admin never learns the
  // agent's password" property — see memory owner-overrides-security-model.
  passwordPlain                  String?
  // Loop C3 — set on every successful password change (self-service
  // reset via WhatsApp OTP, or an admin-triggered reset-link consumption
  // — NOT on initial invite consumption, since there's no prior session
  // to invalidate then). src/auth.ts's jwt callback compares this
  // against the JWT's own issued-at time, same live-recompute pattern
  // already used for `disabled` — so a reset kills every other
  // outstanding session on its very next request, not just future logins.
  passwordChangedAt              DateTime?
  name                           String
  role                           Role                     @default(AGENT)
  // Revocation for a terminated/compromised account. auth.config.ts's jwt
  // callback checks this on every request (not just at sign-in) so a
  // revoked account's existing JWT stops working immediately rather than
  // staying valid for up to the session's 30-day default lifetime — see
  // that file's comment for why a DB check inside the JWT callback is an
  // accepted latency/security tradeoff here.
  disabled                       Boolean                  @default(false)
  disabledAt                     DateTime?
  // --- Agent registration (post-invite profile completion) ---
  // Normalized via src/lib/phone-normalize.ts's normalizeToE164() before
  // storage, same convention as Contact.numberE164 and
  // DoNotCallEntry.numberE164. Nullable-unique is correct Postgres
  // behavior here: many NULLs are allowed (most rows, before an agent
  // registers) while no two real numbers may collide.
  phoneE164                      String?                  @unique
  phoneVerifiedAt                DateTime?
  // NULL = the agent verified it themselves via OTP (Firebase or the
  // WhatsApp fallback). Set = an admin overrode verification (their user
  // id). Kept distinguishable deliberately — an override is a weaker
  // claim than a real OTP round-trip, and an auditor should be able to
  // tell the two apart at a glance rather than inferring it from
  // AuditLog metadata.
  phoneVerifiedByAdminId         String?
  phoneVerifiedByAdmin           User?                    @relation("PhoneVerifiedByAdmin", fields: [phoneVerifiedByAdminId], references: [id])
  phoneVerifiedOverrides         User[]                   @relation("PhoneVerifiedByAdmin")
  address                        String?
  photoPath                      String?
  // Set only once the registration form (name/address/phone/photo) AND
  // phone verification both succeed — see src/middleware.ts and
  // GET /api/me/sip-credentials, the two places that actually gate an
  // agent's access on this being non-null.
  profileCompletedAt             DateTime?
  // Per-admin "last viewed the sign-in feed" marker — powers the unread
  // badge on /admin/sign-ins without a separate read-state table.
  signInFeedSeenAt               DateTime?
  // Same read-state-marker pattern as signInFeedSeenAt above, but for an
  // agent's own missed-call list (GET /api/me/missed-calls) — no new
  // table needed since CallDetailRecord.agentExtension/disposition
  // already carry everything the list needs; this is just "have they
  // looked" for badge purposes.
  missedCallsSeenAt              DateTime?
  // Same read-state-marker pattern as missedCallsSeenAt above, but for an
  // agent's own voicemail inbox (GET /api/voicemail) — voicemail itself
  // stays filesystem-only (see src/lib/voicemail-spool.ts), this is just
  // "have they looked" for badge purposes, keyed off each message's
  // origtime rather than a per-message read table.
  voicemailSeenAt                DateTime?
  extension                      Extension?
  doNotCallEntries               DoNotCallEntry[]
  hiddenRecordings               Recording[]
  escalationAttempts             EscalationAttempt[]
  auditLogs                      AuditLog[]
  invitesCreated                 Invite[]                 @relation("InviteCreatedBy")
  invite                         Invite?
  waInstancesPaired              WaInstance[]
  // The single SIM port / WhatsApp identity this agent owns (one agent per
  // port, see WaInstance.assignedUserId). Nullable — an agent may exist
  // with no port assigned when all four are already taken.
  waInstance                     WaInstance?              @relation("WaInstanceAssignedUser")
  assignedConversations          Conversation[]
  smsAccessRequestsMade          SmsAccessRequest[]       @relation("SmsAccessRequestedBy")
  smsAccessRequestsDecided       SmsAccessRequest[]       @relation("SmsAccessDecidedBy")
  loginAttempts                  LoginAttempt[]
  otpChallenges                  OtpChallenge[]
  trustedDevices                 TrustedDevice[]
  // P2 CRM data layer (2026-08-31) — see Contact/ContactNote/ContactTask/
  // CallDisposition for the forward side of each of these.
  ownedContacts                  Contact[]                @relation("ContactOwner")
  contactNotes                   ContactNote[]            @relation("ContactNoteAuthor")
  contactTasks                   ContactTask[]            @relation("ContactTaskAssignee")
  callDispositions               CallDisposition[]        @relation("CallDispositionAgent")
  // Feature B3 (2026-08-31) — one-contact-one-owner conflict resolution.
  // Three distinct roles a User can play against the same request row, so
  // three separately-named relations (Prisma requires each ambiguous
  // relation on a model pair to be disambiguated) — same reasoning as
  // SmsAccessRequest's requestedBy/decidedBy split above.
  contactTransferRequestsMade    ContactTransferRequest[] @relation("ContactTransferRequestedBy")
  contactTransferRequestsOwned   ContactTransferRequest[] @relation("ContactTransferCurrentOwner")
  contactTransferRequestsDecided ContactTransferRequest[] @relation("ContactTransferDecidedBy")
  // Full CRM — pipeline + companies + unified timeline (S2, 2026-09-01).
  ownedCompanies                 Company[]                @relation("CompanyOwner")
  ownedDeals                     Deal[]                   @relation("DealOwner")
  dealNotes                      DealNote[]               @relation("DealNoteAuthor")
  activities                     Activity[]               @relation("ActivityActor")
  // "light" | "dark" | "system"; NULL = system. Persisted per user so the
  // theme survives a device change; the client still writes localStorage
  // first for the no-flash script.
  themePreference                String?
  createdAt                      DateTime                 @default(now())
  updatedAt                      DateTime                 @updatedAt

  @@index([disabled])
  @@index([profileCompletedAt])
  @@index([tenantId])
}

enum OtpPurpose {
  PHONE_VERIFICATION
  LOGIN_2FA
  // Loop C3 — self-service password reset, reusing the same OtpChallenge
  // machinery (5/hour send throttle, 5-attempt guess throttle, hashed
  // codes) rather than inventing a parallel one.
  PASSWORD_RESET
}

enum OtpChannel {
  WHATSAPP
  SMS
}

// Server-side OTP challenge state — used ONLY by the WhatsApp fallback
// (registration) and by login 2FA (Workstream 6). The PRIMARY
// registration path (Firebase Phone Auth) needs none of this: Firebase
// manages its own challenge/attempt/expiry state, and the server only
// ever verifies the resulting ID token (see src/lib/firebase/admin.ts) —
// never a code typed against a row in this table.
//
// This table doubles as its own rate limiter rather than reusing
// src/lib/rate-limit.ts's checkSimpleRateLimit(): that limiter is an
// in-process Map, explicitly documented there as acceptable only for
// "lower-value targets" since it resets on restart and doesn't work
// across replicas. An OTP is exactly the kind of thing that needs a
// real, DB-backed limit — send-throttling is "count challenges created
// for this userId in the last hour", guess-throttling is `attempts`
// capped at 5, both correct regardless of process restarts or replica
// count.
model OtpChallenge {
  id         String     @id @default(cuid())
  tenantId   String
  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  user       User       @relation(fields: [userId], references: [id])
  userId     String
  phoneE164  String
  // SHA-256 of the 6-digit code — the plaintext code is never persisted,
  // same one-way-hash discipline as every other secret in this schema.
  codeHash   String
  purpose    OtpPurpose
  channel    OtpChannel
  expiresAt  DateTime
  attempts   Int        @default(0)
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
  @@index([tenantId])
}

// Remembers a browser/device that has already cleared login 2FA, so an
// agent isn't OTP-challenged on every single sign-in from their usual
// machine (Workstream 6) — only on a new device or IP. The raw token
// lives in an httpOnly cookie on the client; only its hash is stored
// here, matching the Invite/ApiKey/McpApproval one-time-disclosure
// pattern used everywhere else in this schema.
model TrustedDevice {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  tokenHash  String   @unique
  // Short user-agent summary for the agent/admin to recognize the device
  // by, not a fingerprinting mechanism.
  label      String?
  lastSeenIp String?
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([tenantId])
}

// Login rate-limiting / lockout state (Workstream C — there was previously
// no defense at all against unlimited password guessing). One row per
// (email, ip) bucket rather than per-account-only, so a single leaked
// account can't be used to fingerprint-limit an attacker off of other
// accounts, and a single IP hammering many emails is still tracked.
// Cleared on successful login; see src/lib/rate-limit.ts.
model LoginAttempt {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  email       String
  ip          String
  attempts    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])

  @@unique([email, ip])
  @@index([lockedUntil])
  @@index([tenantId])
}

// Single-use, short-expiry agent onboarding tokens (Workstream D). Replaces
// the previous flow where an admin typed a "temporary password" that was
// never emailed and never rotatable. An agent can set their password
// exactly once, at /invite/[token]; there is deliberately no route that
// lets them change it again afterward — see api/admin/users/route.ts's
// comment on why that's a requirement, not an oversight.
model Invite {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
  userId      String    @unique
  // SHA-256 of the actual token — the token itself is only ever in the
  // emailed URL and the client's one request to consume it, never stored
  // or logged in plaintext (same pattern as a password reset token).
  tokenHash   String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdById String
  createdBy   User      @relation("InviteCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([expiresAt])
  @@index([tenantId])
}

model Extension {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  number         String // e.g. "1001" — matches the PJSIP endpoint id generated into pjsip_dynamic.conf. Was globally @unique; now tenant-composite (plan §1).
  kind           String         @default("webrtc") // "webrtc" | "hardware"
  user           User?          @relation(fields: [userId], references: [id])
  userId         String?        @unique
  status         AgentStatus    @default(OFFLINE)
  lastSeenAt     DateTime?
  // The PJSIP digest-auth secret for this endpoint — deliberately NOT the
  // same value as User.passwordHash. passwordHash is a one-way bcrypt hash
  // (correct for a web login, useless for Asterisk's SIP digest auth, which
  // needs the plaintext-equivalent secret). Generated server-side
  // (crypto.randomBytes) when the extension is created; never returned to
  // anyone but the owning user's own authenticated session (GET
  // /api/me/sip-credentials) or staff provisioning it. Not encrypted at
  // rest yet — flagged as a gap in LLM.md, same tier of risk as any other
  // plaintext service-account secret in this schema today.
  sipSecret      String?
  // Numeric PIN for VoicemailMain() access (Phase E) — a separate secret
  // from both sipSecret (SIP digest auth) and User.passwordHash (web
  // login). Generated server-side alongside sipSecret, same one-time-
  // disclosure treatment via GET /api/me/sip-credentials.
  voicemailPin   String?
  // Loop C2 — which of the three chained outbound dialplan contexts
  // (from-agent-local/-national/-international in extensions.conf) this
  // endpoint's generated PJSIP stanza points `context=` at. See
  // DialPermission's own comment for why this exists. Defaults to the
  // most restrictive tier.
  dialPermission DialPermission @default(LOCAL)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([tenantId, number])
  @@index([tenantId])
}

model Queue {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  name      String // e.g. "support_queue" — matches extensions.conf. Was globally @unique; now tenant-composite (plan §1).
  strategy  String        @default("ringall") // "ringall" | "leastrecent" | "roundrobin"
  members   QueueMember[]
  createdAt DateTime      @default(now())

  @@unique([tenantId, name])
  @@index([tenantId])
}

model QueueMember {
  id        String @id @default(cuid())
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id])
  queue     Queue  @relation(fields: [queueId], references: [id])
  queueId   String
  extension String
  penalty   Int    @default(0)

  @@unique([queueId, extension])
  @@index([tenantId])
}

model CallDetailRecord {
  id               String      @id @default(cuid())
  tenantId         String
  tenant           Tenant      @relation(fields: [tenantId], references: [id])
  uniqueId         String      @unique // Asterisk's linkedid/uniqueid for the call
  callerNumber     String
  // Normalized E.164 form of callerNumber (P2, 2026-08-31), backfilled and
  // indexed — what makes caller-ID -> contact matching correct and O(1)
  // instead of api/crm/contacts/[id]/activity's pre-existing approach of
  // pulling the last 2000 CDRs and normalizing every one in-process on
  // every request (still there for the Bearer-key CRM route; the new
  // session-authed /api/agent/crm/** routes use this column instead).
  // Nullable because normalizeToE164() can genuinely fail on a malformed
  // legacy row — never silently coerced to "".
  callerNumberE164 String?
  destination      String
  direction        String // "inbound" | "outbound" | "internal"
  disposition      String // "ANSWERED" | "NO ANSWER" | "BUSY" | "FAILED"
  startedAt        DateTime
  answeredAt       DateTime?
  endedAt          DateTime?
  durationSec      Int         @default(0)
  billsecSec       Int         @default(0)
  recordingUrl     String? // kept for backward compat; Recording is the source of truth going forward (Phase D)
  queueName        String?
  agentExtension   String?
  createdAt        DateTime    @default(now())
  recordings       Recording[]

  @@index([startedAt])
  @@index([agentExtension])
  @@index([callerNumberE164])
  @@index([tenantId])
}

// Do Not Call compliance blocklist (Phase C). Enforcement is defense-in-
// depth across TWO layers, and this table is the shared source of truth for
// both, even though they can't literally share code:
//   1. App layer: GET /api/dnc/check, called from the softphone before
//      dialing (src/contexts/sip-context.tsx) — good UX (immediate
//      feedback), but bypassable by a hardware SIP phone dialing straight
//      into extensions.conf.
//   2. Dialplan layer (mandatory, closes that gap): a func_odbc lookup in
//      extensions.conf's [from-agent] outbound context, straight against
//      this table via a direct Postgres ODBC connection — see
//      pbx_configs/{res_odbc,func_odbc}.conf and extensions.conf's DNC_CHECK
//      comment for the normalization caveat (the dialplan can't call
//      src/lib/phone-normalize.ts, so it does a cruder direct-string match).
model DoNotCallEntry {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  numberE164 String // normalized via src/lib/phone-normalize.ts before storage. Was globally @unique; now tenant-composite (plan §1).
  reason     String?
  source     String   @default("manual") // "manual" | "bulk_import"
  addedById  String
  addedBy    User     @relation(fields: [addedById], references: [id])
  createdAt  DateTime @default(now())

  @@unique([tenantId, numberE164])
  @@index([tenantId])
}

// Recording retention with asymmetric agent/admin deletion (Phase D).
// Requirement, verbatim: "the voice recording will be on admin side also
// but the agent side deletion will not delete the recording."
//
// A dedicated model rather than more CallDetailRecord fields: recordings
// have their own lifecycle (file path, size, hidden state) independent of
// the call record itself, and a future phase (attended transfer / conference,
// Phases F/G) could produce more than one recording per call.
//
// "Ownership" of a recording is inherited from its CallDetailRecord via
// agentExtension — a bare string, not a foreign key (see that model's
// comment) — matched against the caller's session.user.extension. The
// single source of truth for the allow/deny decision is the pure function
// src/lib/recording-access.ts's canAccessRecording(), used identically by
// both the listing endpoint (GET /api/recordings) and the byte-serving
// route (GET /api/recordings/[uniqueid]) so they cannot drift apart — a
// hidden recording must be unreachable by direct URL, not merely absent
// from a list.
model Recording {
  id                String           @id @default(cuid())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  cdrId             String
  cdr               CallDetailRecord @relation(fields: [cdrId], references: [id])
  filePath          String // relative to RECORDINGS_DIR, e.g. "<uniqueId>.wav"
  fileSizeBytes     Int?
  // Agent-side "hide" only — never a delete. Staff/admin still see and can
  // stream the recording regardless of this field; only an agent's own
  // view (GET /api/recordings, and the byte-serving route when the caller
  // is an AGENT) respects it.
  hiddenFromAgentAt DateTime?
  hiddenByUserId    String?
  hiddenByUser      User?            @relation(fields: [hiddenByUserId], references: [id])
  createdAt         DateTime         @default(now())

  @@index([cdrId])
  @@index([tenantId])
}

// Audit trail — originally scoped to recording lifecycle actions only, now
// the shared audit sink for every sensitive admin/supervisor action in the
// system: recording hide/hard-delete, voicemail delete, call intervention
// (spy/whisper/barge), invite issue/consume/revoke, WhatsApp instance
// pair/logout, SMS access-request approve/decline/revoke, and MCP write-
// tool calls (Workstream F). `action` is a free-form dotted string
// ("domain.verb") by convention, not an enum, so new action types never
// need a migration.
model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  action    String // e.g. "recording.hide" | "recording.hard_delete" | "intervention.barge" | "sms_access.approve"
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  targetId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  // Was entirely unindexed — the audit table was flagged as the first
  // thing to degrade under real usage, and every admin-facing "recent
  // activity" view needs at least one of these.
  @@index([actorId])
  @@index([createdAt])
  @@index([action])
  @@index([tenantId])
}

// Periodic client-side WebRTC quality samples (Workstream B) — see
// src/lib/webrtc-stats.ts. Joined to CallDetailRecord.uniqueId via the SIP
// Call-ID captured client-side at call start (sip-context.tsx), NOT a hard
// foreign key: samples can arrive before the CDR row exists (the CDR is
// created by the AMI listener asynchronously after the call ends), and a
// sample stream for a call that never got a CDR (e.g. a failed AMI ingest)
// should still be retained for diagnosis rather than being rejected.
model CallQualitySample {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id])
  callId              String // SIP Call-ID / uniqueId correlation key, not an FK — see comment above
  extension           String? // the agent extension this sample was captured on, for MCP/troubleshooting queries
  jitterMs            Float?
  packetsLost         Int?
  packetsReceived     Int?
  roundTripTimeMs     Float?
  jitterBufferDelayMs Float?
  mosEstimate         Float?
  // Added 2026-08-29: extractCallQuality() previously read ONLY
  // inbound-rtp/candidate-pair, so there was no record of the agent's OWN
  // outgoing audio — "is the mic actually producing sound" could only be
  // answered by decoding a live packet capture by hand, which happened
  // twice in one session. audioLevel/totalAudioEnergy come from the
  // sender's `media-source` stats (the local mic, before encoding) so they
  // reflect what the mic itself is producing independent of whether the
  // network ever delivers it.
  packetsSent         Int?
  audioLevel          Float?
  totalAudioEnergy    Float?
  createdAt           DateTime @default(now())

  @@index([callId])
  @@index([createdAt])
  @@index([tenantId])
}

// =========================================
// MANAGER ESCALATION (Loop C1) — admin-managed named list an agent can
// transfer/forward a live call to, plus outcome tracking so a busy/
// unanswered escalation is visible somewhere other than the agent's own
// screen. The actual transfer is the existing blindTransfer() SIP REFER
// (src/contexts/sip-context.tsx) — nothing new at the call-control layer.
// =========================================

enum EscalationOutcome {
  ANSWERED
  BUSY
  NO_ANSWER
  FAILED
  UNKNOWN
}

model EscalationTarget {
  id          String              @id @default(cuid())
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  name        String
  // At least one of extension/phoneE164 is required (enforced in the API
  // route, not the schema — Prisma has no CHECK-constraint DSL) since a
  // target might be an internal extension, an external number reached
  // only via the Dinstar trunk, or both.
  extension   String?
  phoneE164   String?
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  createdById String?
  attempts    EscalationAttempt[]

  @@index([tenantId])
}

model EscalationAttempt {
  id         String            @id @default(cuid())
  tenantId   String
  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  agentId    String
  agent      User              @relation(fields: [agentId], references: [id])
  // Nullable + SET NULL on delete (not RESTRICT): deleting a manager from
  // the escalation list must not be blocked by, or destroy, past attempt
  // history — the attempt still happened even if the target is later
  // removed. denormalized `targetName` below preserves who it was for
  // display once the relation itself is gone.
  targetId   String?
  target     EscalationTarget? @relation(fields: [targetId], references: [id], onDelete: SetNull)
  targetName String
  outcome    EscalationOutcome @default(UNKNOWN)
  // Whether the WhatsApp busy/no-answer ping to the manager was actually
  // sent — distinct from `outcome`, since the transfer itself succeeding
  // or failing is independent of whether the follow-up notification did.
  waNotified Boolean           @default(false)
  waError    String?
  createdAt  DateTime          @default(now())
  resolvedAt DateTime?

  @@index([agentId])
  @@index([targetId])
  @@index([createdAt])
  @@index([tenantId])
}

// =========================================
// WORKSTREAM E — WhatsApp + SMS unified messaging
// =========================================

enum MessageChannel {
  WHATSAPP
  SMS
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageProviderKind {
  OPENWA
  META_CLOUD
  DINSTAR_SMS
  // Added 2026-08-29: a GSM port assignment with no messaging identity
  // attached. Before this, a port could only be assigned to an agent by
  // first creating a WaInstance row, and creating one with provider=OPENWA
  // unconditionally starts a real OpenWA WhatsApp pairing session
  // (src/app/api/admin/whatsapp/instances/route.ts) — so a purely
  // calls-only port (the operator's actual request) could not be assigned
  // at all without dragging WhatsApp pairing along with it. NONE never
  // reaches getProvider() — every send/conversation-creation path must
  // reject it explicitly (see conversations/route.ts and
  // conversations/[id]/messages/route.ts).
  NONE
}

enum WaInstanceStatus {
  PAIRING
  CONNECTED
  DISCONNECTED
  LOGGED_OUT
}

// One row per Dinstar SIM port paired as a WhatsApp identity (up to 4 —
// the hardware ceiling). Pairing, re-pairing, and logout are admin-only
// actions (requireAdminSession, see src/app/admin/whatsapp) — agents get a
// read-only connection-status view in their own UI with NO logout control
// rendered and no route that would accept one if forged, per the
// requirement that only an admin can log an agent's WhatsApp session out.
model WaInstance {
  id        String              @id @default(cuid())
  tenantId  String
  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  label     String // e.g. "SIM 1 — +971 5X XXX XXXX". Was globally @unique; now tenant-composite (plan §1).
  // 1-4, the Dinstar UC2000 port this identity was paired via OTP on. Was
  // globally @unique; now tenant-composite. NOTE (plan §1): this is only
  // correct because each tenant gets their OWN Dinstar gateway — two
  // tenants sharing one gateway would break this; call it out in the
  // provisioning UI.
  simPort   Int
  phoneE164 String? // populated once pairing completes
  provider  MessageProviderKind @default(OPENWA)
  status    WaInstanceStatus    @default(DISCONNECTED)

  // --- OpenWA session binding ---------------------------------------------
  /// The OpenWA session `name` we created (alphanumeric + hyphens, 3-50),
  /// derived once at create time via openwa-client.ts's sessionNameFor() —
  /// never the raw cuid, so a schema-level id change can't orphan a live
  /// session.
  sessionName         String?   @unique
  /// The id OpenWA itself assigned to the session. Every /api/sessions/{id}/*
  /// call uses THIS, not WaInstance.id.
  openwaSessionId     String?   @unique
  /// Raw upstream OpenWaSessionStatus, kept alongside the coarser `status`
  /// above for admin debugging (see openwa-types.ts's toWaInstanceStatus()).
  providerStatusRaw   String?
  pushName            String?
  lastError           String?
  lastStatusAt        DateTime?
  /// data:image/png;base64 QR, cached so a page reload mid-pairing doesn't
  /// lose it. Cleared on ready/logout. Never selected by any agent-reachable
  /// route.
  lastQrCode          String?   @db.Text
  lastQrAt            DateTime?
  pairingCode         String?
  pairingCodeAt       DateTime?
  webhookRegisteredAt DateTime?
  // -------------------------------------------------------------------------

  pairedByAdminId String?
  pairedByAdmin   User?          @relation(fields: [pairedByAdminId], references: [id])
  // One agent per SIM port (the Dinstar hardware ceiling is 4, so this is
  // also the ceiling on how many agents can hold a WhatsApp-enabled seat).
  // Provisioning happens at user-creation time (src/app/api/admin/users) —
  // this is ownership, distinct from pairedByAdminId above, which is only
  // an audit stamp of who ran the pairing flow.
  assignedUserId  String?        @unique
  assignedUser    User?          @relation("WaInstanceAssignedUser", fields: [assignedUserId], references: [id])
  lastConnectedAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  conversations   Conversation[]

  @@unique([tenantId, label])
  @@unique([tenantId, simPort])
  @@index([tenantId])
}

// Idempotency ledger for OpenWA's inbound webhook deliveries
// (X-OpenWA-Idempotency-Key) — OpenWA retries a delivery that doesn't get a
// 2xx, so a delivery seen before must not be re-ingested as a new message.
// PLATFORM-GLOBAL — deliberately NOT tenant-scoped (plan §1/§7): this is a
// dedup ledger keyed on the sidecar's own idempotency key, independent of
// which tenant a delivery eventually resolves to.
model InboundWebhookDelivery {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique
  deliveryId     String?
  event          String
  receivedAt     DateTime @default(now())

  @@index([receivedAt])
}

// The only E.164-canonical contact identity in the schema besides
// DoNotCallEntry — deliberately copies that model's pattern (numberE164
// unique, normalized via src/lib/phone-normalize.ts before storage) so the
// two can be joined without re-normalizing. Note WhatsApp's own wa_id is
// E.164 *without* the leading '+' — the inbound webhook handler must
// prefix it before calling normalizeToE164().
model Contact {
  id                String                   @id @default(cuid())
  tenantId          String
  tenant            Tenant                   @relation(fields: [tenantId], references: [id])
  numberE164        String // Was globally @unique; now tenant-composite (plan §1).
  displayName       String?
  // CRM fields (P2, 2026-08-31) — additive to the pre-existing bare
  // {id, numberE164, displayName} shape. `dncBlocked` is deliberately NOT
  // a column here: it is derived at read time from DoNotCallEntry so
  // there is exactly one source of truth for "is this number blocked",
  // matching the DNC check's existing design rather than risking the two
  // drifting apart.
  email             String?
  // Free-text company name kept for import back-compat (bulk-import writes
  // it directly). `companyRel` (S2, 2026-09-01) is the structured link; a
  // one-time backfill matches obvious names, the rest stay string-only.
  company           String?
  companyId         String?
  companyRel        Company?                 @relation("CompanyContacts", fields: [companyId], references: [id])
  // WhatsApp profile picture (2026-09-01). `waAvatarUrl` is the raw
  // pps.whatsapp.net URL OpenWA returns — it expires and is cross-origin,
  // so the UI never loads it directly; GET /api/messaging/avatar/[contactId]
  // proxies it and refetches from OpenWA when null or stale (waAvatarCheckedAt).
  waAvatarUrl       String?
  waAvatarCheckedAt DateTime?
  tags              String[]                 @default([])
  ownerId           String?
  owner             User?                    @relation("ContactOwner", fields: [ownerId], references: [id])
  notes             ContactNote[]
  tasks             ContactTask[]
  dispositions      CallDisposition[]
  conversations     Conversation[]
  transferRequests  ContactTransferRequest[]
  deals             DealContact[]
  activities        Activity[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@unique([tenantId, numberE164])
  @@index([companyId])
  @@index([ownerId])
  @@index([tenantId])
}

enum ContactTransferRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

// Feature B3 (2026-08-31) — "notifies owner + manager" for a one-contact-
// one-owner conflict, realistically: a row a polling UI surface picks up.
// Mirrors SmsAccessRequest's request -> approve/decline shape exactly (see
// that model's comment) rather than inventing a new pattern.
// currentOwnerId is denormalized at request time, same reasoning
// SmsAccessRequest/EscalationAttempt already use — Contact.ownerId can
// change (approval itself changes it) or be cleared (deactivation, B6)
// after this row is created, and the request's own history should still
// read correctly once that's happened.
model ContactTransferRequest {
  id             String                       @id @default(cuid())
  tenantId       String
  tenant         Tenant                       @relation(fields: [tenantId], references: [id])
  contactId      String
  contact        Contact                      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  requestedById  String
  requestedBy    User                         @relation("ContactTransferRequestedBy", fields: [requestedById], references: [id])
  currentOwnerId String
  currentOwner   User                         @relation("ContactTransferCurrentOwner", fields: [currentOwnerId], references: [id])
  status         ContactTransferRequestStatus @default(PENDING)
  decidedById    String?
  decidedBy      User?                        @relation("ContactTransferDecidedBy", fields: [decidedById], references: [id])
  decidedAt      DateTime?
  createdAt      DateTime                     @default(now())

  @@index([status])
  @@index([contactId])
  @@index([requestedById])
  @@index([currentOwnerId])
  @@index([tenantId])
}

// P2 CRM data layer (2026-08-31) — agents create/edit these from the
// unified console (P3); admin gets a read + attribution view over all of
// it (see /admin/contacts). Every row carries who entered it.
model ContactNote {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("ContactNoteAuthor", fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([contactId])
  @@index([tenantId])
}

model ContactTask {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  contactId   String
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assigneeId  String
  assignee    User      @relation("ContactTaskAssignee", fields: [assigneeId], references: [id])
  // Optional deal scope (S2, 2026-09-01) — a task can belong to a pipeline
  // deal as well as its contact. Nullable keeps every existing row valid.
  dealId      String?
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  title       String
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([contactId])
  @@index([assigneeId])
  @@index([dealId])
  @@index([tenantId])
}

enum CallDispositionOutcome {
  INTERESTED
  CALLBACK
  NOT_INTERESTED
  DNC
}

// Choosing DNC also writes a DoNotCallEntry, in the same transaction (see
// POST /api/agent/crm/dispositions) — this is the one CRM write with a
// compliance side effect, so it cannot be allowed to record a DNC
// disposition without the blocklist entry actually landing.
model CallDisposition {
  id          String                 @id @default(cuid())
  tenantId    String
  tenant      Tenant                 @relation(fields: [tenantId], references: [id])
  contactId   String
  contact     Contact                @relation(fields: [contactId], references: [id], onDelete: Cascade)
  cdrUniqueId String?
  outcome     CallDispositionOutcome
  note        String?
  agentId     String
  agent       User                   @relation("CallDispositionAgent", fields: [agentId], references: [id])
  createdAt   DateTime               @default(now())

  @@index([contactId])
  @@index([tenantId])
}

// ===========================================================================
// Full CRM — companies, pipeline, unified activity timeline (S2, 2026-09-01).
// Feature-forked from marmelab/atomic-crm onto our Prisma/Postgres stack
// (NOT Supabase). Additive to the P2 CRM data layer above.
// ===========================================================================

model Company {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  name      String
  domain    String?
  phone     String?
  address   String?
  ownerId   String?
  owner     User?     @relation("CompanyOwner", fields: [ownerId], references: [id])
  contacts  Contact[] @relation("CompanyContacts")
  deals     Deal[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([ownerId])
  @@index([name])
  @@index([tenantId])
}

// DB-driven so the operator can re-order / rename stages without a deploy.
// Seeded in the migration: Lead, Qualified, Proposal, Negotiation, Won, Lost.
// Per-tenant (plan §1): operator-editable, so each tenant gets its own
// seeded stage set rather than sharing one global pipeline.
model PipelineStage {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  name      String
  sortOrder Int
  isWon     Boolean @default(false)
  isLost    Boolean @default(false)
  color     String? // a token name, e.g. "accent" | "success" | "danger"
  deals     Deal[]

  @@index([sortOrder])
  @@index([tenantId])
}

model Deal {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  name            String
  companyId       String?
  company         Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  stageId         String
  stage           PipelineStage @relation(fields: [stageId], references: [id])
  value           Decimal       @default(0) @db.Decimal(14, 2)
  currency        String        @default("AED")
  ownerId         String
  owner           User          @relation("DealOwner", fields: [ownerId], references: [id])
  expectedCloseAt DateTime?
  closedAt        DateTime?
  contacts        DealContact[]
  notes           DealNote[]
  tasks           ContactTask[]
  activities      Activity[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([stageId])
  @@index([ownerId])
  @@index([companyId])
  @@index([tenantId])
}

// Deal <-> Contact is many-to-many (atomic-crm's shape) — one deal can
// involve several people at a company. No tenantId here (not in wave 1's
// customer-owned model list): both dealId and contactId already resolve to
// a tenant-scoped row, so this pure join table rides on those.
model DealContact {
  dealId    String
  deal      Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  isPrimary Boolean @default(false)

  @@id([dealId, contactId])
  @@index([contactId])
}

model DealNote {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("DealNoteAuthor", fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([dealId])
  @@index([tenantId])
}

enum ActivityType {
  CALL
  WHATSAPP
  SMS
  NOTE
  DEAL_STAGE_CHANGE
  TASK
}

// The unified timeline. One row per real-world event, written at the same
// hooks that already exist (CDR ingest, message send/ingest, note/task/
// disposition create, deal stage move) plus a one-time idempotent backfill
// from historical CallDetailRecord + ChatMessage. `refId` is the source
// row's natural id (cdr uniqueId / chatMessage id / note id / …) — NOT a
// FK, so this table stays decoupled from the sources it summarizes and the
// backfill + live writes are both idempotent via @@unique([type, refId]).
model Activity {
  id         String       @id @default(cuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  type       ActivityType
  contactId  String?
  contact    Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId     String?
  deal       Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  summary    String
  occurredAt DateTime     @default(now())
  actorId    String?
  actor      User?        @relation("ActivityActor", fields: [actorId], references: [id])
  refId      String?
  createdAt  DateTime     @default(now())

  // Was @@unique([type, refId]); now tenant-composite (plan §1) since refId
  // is a bare correlation key, not an FK, and is only unique per tenant.
  @@unique([tenantId, type, refId])
  @@index([contactId, occurredAt])
  @@index([dealId, occurredAt])
  @@index([tenantId])
}

// A conversation is scoped to (contact, channel) — a contact can have both
// an open WhatsApp thread and an open SMS thread simultaneously, shown
// interleaved in the agent UI (channel badge per message) but tracked as
// two rows so read/unread and assignment can differ per channel.
// assignedAgentId is the ownership mechanism requested: with 4 shared
// WaInstances (one per SIM) rather than one per agent, this field is what
// stops two agents replying to the same customer, not the WaInstance
// itself.
model Conversation {
  id              String         @id @default(cuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  contact         Contact        @relation(fields: [contactId], references: [id])
  contactId       String
  channel         MessageChannel
  waInstance      WaInstance?    @relation(fields: [waInstanceId], references: [id])
  waInstanceId    String?
  assignedAgent   User?          @relation(fields: [assignedAgentId], references: [id])
  assignedAgentId String?
  lastMessageAt   DateTime?
  unreadCount     Int            @default(0)
  // Last time history-sync.ts pulled backlog from the provider for this
  // thread (2026-09-01). The webhook only delivers NEW messages; opening a
  // thread triggers a rate-limited pull of older ones from OpenWA.
  historySyncedAt DateTime?
  messages        ChatMessage[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([contactId, channel, waInstanceId])
  @@index([assignedAgentId])
  @@index([lastMessageAt])
  @@index([tenantId])
}

// Named ChatMessage, not Message — "message" is already heavily
// overloaded across the codebase for voicemail messages and raw AMI
// protocol framing (30+ call sites); a distinct name avoids that
// collision rather than fighting it with import aliases everywhere.
model ChatMessage {
  id                String             @id @default(cuid())
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  conversation      Conversation       @relation(fields: [conversationId], references: [id])
  conversationId    String
  direction         MessageDirection
  body              String?
  mediaUrl          String?
  mediaMimeType     String?
  // "voice" | "image" | "video" | "audio" | "document" | "sticker" (2026-09-01)
  // — so the chat UI picks the right bubble without mime-sniffing (voice vs
  // plain audio, sticker vs image).
  mediaKind         String?
  // Base64 of the media payload, captured at ingest from OpenWA's
  // `metadata.media.data` (the sidecar's own `/media` sub-endpoint 404s for
  // received media it never archived). Size-capped in ingest.ts; over the
  // cap the row keeps mediaKind but mediaData stays null and the proxy
  // falls back to the sidecar. Never SELECTed except by
  // GET /api/messaging/media/[id]. (2026-09-01)
  mediaData         String?            @db.Text
  providerMessageId String? // OpenWA's internal message id / Meta / Dinstar id — for status-webhook correlation
  // OpenWA's WhatsApp message id (the `waMessageId` field). Distinct from
  // providerMessageId (OpenWA's own row id). This is what
  // GET /api/sessions/:s/messages/:chatId/:id/media wants, and the dedup key
  // for history-sync.ts. (2026-09-01)
  waMessageId       String?
  deliveryStatus    String             @default("pending") // "pending" | "sent" | "delivered" | "read" | "failed"
  // OTP/verification-code heuristic classification (Workstream E,
  // SIM-SMS-only in practice today — WhatsApp OTPs aren't routed through
  // us). A `sensitive` message is never returned by any agent-facing API
  // response; see src/lib/messaging/sensitive-detect.ts and
  // api/messaging/conversations/[id]/messages/route.ts's filter.
  sensitive         Boolean            @default(false)
  accessRequests    SmsAccessRequest[]
  createdAt         DateTime           @default(now())

  @@index([conversationId, createdAt])
  @@index([providerMessageId])
  @@index([waMessageId])
  @@index([tenantId])
}

// Rooms (Workstream E, client requirement: "just a UI view, no data model
// change" in spirit — no tenancy, no row-level scoping added to any other
// model). This is the one minimal table needed to let an admin NAME and
// PERSIST a group of agents to view together; storing that only in
// component state would lose it on every page reload. memberUserIds is a
// plain JSON array of User.id, not a join table — a room is a saved
// filter, not a relation other models need to query through.
// tenantId added in the multi-tenant wave (plan §1) — a room's member list
// is agents, and agents are tenant-scoped, so the room name only needs to
// stay unique within a tenant.
model Room {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  name          String // Was globally @unique; now tenant-composite.
  memberUserIds Json // string[] of User.id
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

enum SmsAccessRequestStatus {
  PENDING
  APPROVED
  DECLINED
  REVOKED
}

// The lock -> request -> admin-approve/decline/revoke workflow for sensitive
// (OTP-shaped) SIM SMS. One row per agent's request to view one sensitive
// ChatMessage. Approval is time-boxed (expiresAt) and every transition is
// mirrored into AuditLog so there is a durable record of who saw what OTP
// and when, independent of this table's own current-state row.
model SmsAccessRequest {
  id            String                 @id @default(cuid())
  tenantId      String
  tenant        Tenant                 @relation(fields: [tenantId], references: [id])
  message       ChatMessage            @relation(fields: [messageId], references: [id])
  messageId     String
  requestedBy   User                   @relation("SmsAccessRequestedBy", fields: [requestedById], references: [id])
  requestedById String
  status        SmsAccessRequestStatus @default(PENDING)
  decidedBy     User?                  @relation("SmsAccessDecidedBy", fields: [decidedById], references: [id])
  decidedById   String?
  decidedAt     DateTime?
  expiresAt     DateTime?
  createdAt     DateTime               @default(now())

  @@index([status])
  @@index([requestedById])
  @@index([tenantId])
}

// =========================================
// WORKSTREAM F — internal MCP server approvals
// =========================================
//
// NOTE ON THE MISSING @relation: every model below stores the minting /
// creating admin as a bare `String` user id with an index, NOT a Prisma
// relation. That is deliberate: declaring `mintedByAdmin User @relation(...)`
// would require adding a back-reference field to `User`, and this workstream
// is constrained to APPEND models only — existing models (User included) are
// owned by other workstreams and must not be edited. The tradeoff is that
// Postgres will not enforce referential integrity on these columns; the
// routes that write them always source the id from an authenticated
// `requireAdminSession()` session, so a dangling id can only appear if a
// user row is hard-deleted (which this app never does — see User.disabled).
// Same reasoning as CallDetailRecord.agentExtension being a bare string.

// A single-use, short-expiry capability token an ADMIN mints out-of-band
// (POST /api/admin/mcp-approvals) and pastes into an MCP *write* tool call.
// The MCP server (mcp-server/) is stdio-only and has no session context of
// its own — whoever can run it on the VM can already read everything the
// read tools expose. This table is what stops that same operator (or an LLM
// driving them) from mutating the PBX without a human deliberately
// authorizing that one specific action, once.
//
// Only the SHA-256 of the token is stored, exactly like Invite.tokenHash:
// the raw token exists only in the mint response and the tool call that
// consumes it, never in the DB, never in a log line.
//
// PLATFORM-GLOBAL — deliberately NOT tenant-scoped (plan §1/§7): this is our
// own infra tooling (mcp-server/), minted by a platform operator, not a
// tenant-facing feature.
model McpApproval {
  id              String    @id @default(cuid())
  tokenHash       String    @unique
  mintedByAdminId String
  // The write tool this approval authorizes, e.g. "pjsip.reload" or
  // "container.restart". "*" is an unscoped master approval and is NEVER
  // the default — the mint route requires an explicit opt-in flag to
  // produce one, and the highest-severity tools (restart_container) refuse
  // a "*" approval outright and demand their exact scope.
  scope           String
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([expiresAt])
  @@index([mintedByAdminId])
}

// =========================================
// WORKSTREAM G — CRM connectivity
// =========================================

// An outbound webhook destination. Generic on purpose: no first-class
// HubSpot/Zoho/Salesforce adapter is built (see src/app/api/crm/README.md) —
// this is the substrate such an adapter would sit on after the trial run.
model WebhookSubscription {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  url         String
  // Per-subscription HMAC key. Null means "use CRM_WEBHOOK_SECRET" — the
  // single shared deployment secret. Per-subscription keys are preferable
  // once there is more than one integrator, so one partner's leaked secret
  // can't be used to forge payloads to another.
  secret      String?
  // Event names this destination wants, e.g. ["call.ended","message.received"].
  // Matched with Prisma's `has` (Postgres array containment), so adding a new
  // event type never needs a migration.
  events      String[]
  active      Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())

  @@index([active])
  @@index([createdById])
  @@index([tenantId])
}

// Bearer credentials for the machine-to-machine CRM API under /api/crm/*.
// Separate from User/session auth entirely: an external CRM has no browser
// session and must not be handed one. Same one-time-disclosure discipline as
// Invite and Extension.sipSecret — only the hash is stored.
model ApiKey {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  keyHash     String    @unique
  label       String
  createdById String
  lastUsedAt  DateTime?
  // Soft revocation rather than a delete, so an audit trail of which key
  // touched what survives the key being turned off.
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([revokedAt])
  @@index([createdById])
  @@index([tenantId])
}

// =========================================
// RUNTIME CONFIGURATION (admin-panel-editable settings)
// =========================================

// Every external-service credential the app used to read only from
// process.env (Resend, OpenWA, Meta Cloud, Dinstar SMS, Firebase, CRM
// webhook signing) now resolves DB-first — see
// src/lib/settings/service.ts's getSetting(): database row, else
// process.env[key], else the registry default in
// src/lib/settings/schema.ts. `.env` remains a valid way to seed a value
// and is what a fresh deploy falls back to before an admin ever opens
// /admin/settings; it is never required once a DB row exists.
//
// `valueEncrypted` is AES-256-GCM ciphertext (src/lib/settings/crypto.ts)
// under SETTINGS_ENCRYPTION_KEY — encrypting every setting uniformly,
// not just the "obviously secret" ones, avoids a per-key judgement call
// that would eventually be gotten wrong (e.g. INVITE_FROM_EMAIL looks
// harmless but reveals the sending domain; OTP_CHANNEL looks harmless
// but is still an operational detail worth not leaving in plaintext next
// to actual API keys in the same table). GCM is authenticated, so a
// tampered row fails to decrypt rather than silently yielding
// attacker-chosen plaintext.
//
// Deliberately NOT storing most telephony settings here (AMI, Coturn's
// realm/secret) — those values are duplicated into pbx_configs/manager.conf
// and the Asterisk/Coturn container commands, and editing only the DB side
// would produce a silent mismatch that breaks calls. Making those safely
// editable needs generating those config files from the database too,
// which is out of scope here.
//
// VM_PUBLIC_DOMAIN is the ONE exception (Loop C4, domain-connect
// automation) — its "generate the dependent config too" work now exists:
// POST /api/admin/settings/domain/apply writes
// pbx_configs/generated/caddy.env and the `cert-sync` service (see
// docker-compose.yml) recreates the `caddy` container so the change
// actually takes effect, rather than silently only updating this table.
// NULLABLE tenantId (plan §1/§7): null = platform default, a row = a
// tenant's override. Resolution order (src/lib/settings/service.ts, wave 2+)
// becomes tenant row -> platform row (tenantId null) -> process.env ->
// registry default. Was globally `key @unique`; now tenant-composite so the
// same key can hold both a platform default and per-tenant overrides.
model AppSetting {
  id             String   @id @default(cuid())
  tenantId       String?
  tenant         Tenant?  @relation(fields: [tenantId], references: [id])
  key            String
  valueEncrypted String
  updatedAt      DateTime @updatedAt
  updatedById    String?

  @@unique([tenantId, key])
  @@index([updatedAt])
  @@index([tenantId])
}

// Plain-boolean runtime kill switches the Asterisk dialplan reads DIRECTLY
// over ODBC (pbx_configs/func_odbc.conf: RECORDING_ENABLED,
// RECORDING_ANNOUNCE_ENABLED — same mechanism as DNC_CHECK reading
// DoNotCallEntry). SEPARATE from AppSetting on purpose: AppSetting.valueEncrypted
// is AES-256-GCM ciphertext the dialplan cannot decrypt. Written only by
// POST /api/admin/recording (requireAdminSession, AuditLog). Migration
// 20260901130000_add_pbx_runtime_flags seeds both flags ON (preserves the
// pre-toggle "always record" behaviour). Route code uses $queryRaw/$executeRaw
// against this table; the model exists here so `prisma migrate diff` stays
// clean for future waves. (S6, 2026-09-01.)
//
// PLATFORM-GLOBAL — deliberately NOT tenant-scoped in wave 1 (plan §1/§7,
// explicit instruction). The gap-analysis note that this PK should become
// ([tenantId, key]) is wave 6 work (telephony namespacing), not wave 1 —
// left unchanged here on purpose.
model PbxRuntimeFlag {
  key         String   @id
  enabled     Boolean
  updatedAt   DateTime @default(now()) @updatedAt
  updatedById String?
}

// Dinstar "Remote Server" (syslog) ingest — the gateway pushes GSM/SIP/VPN/
// system events over UDP to a receiver sidecar, which forwards parsed lines
// to POST /api/gateway-events. `siteId` links to GatewaySite (below) once a
// site record exists for the gateway an event came from; still nullable
// since it's optional at ingest time. `receivedAt` is the CANONICAL clock everywhere —
// confirmed live against the real UC2000-VE that its own clock drifts with
// no NTU configured (showed 2025-12-17 on 2026-09-03); `deviceTime` is
// display-only, never used for ordering. `sourceIp` records the packet's
// actual origin since a Tailscale subnet route can SNAT it. `raw` is always
// populated so a classifier miss in syslog-parse.ts is never data loss.
enum GatewaySeverity {
  EMERG
  ALERT
  CRIT
  ERROR
  WARNING
  NOTICE
  INFO
  DEBUG
}

enum GatewayCategory {
  GSM
  SIP
  VPN
  SYSTEM
  RAW
}

model GatewayEvent {
  id         String          @id @default(cuid())
  tenantId   String
  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  receivedAt DateTime        @default(now())
  deviceTime DateTime?
  siteId     String?
  site       GatewaySite?    @relation(fields: [siteId], references: [id])
  sourceIp   String?
  severity   GatewaySeverity
  category   GatewayCategory
  eventType  String?
  port       Int?
  message    String
  raw        String

  @@index([receivedAt])
  @@index([category, receivedAt])
  @@index([eventType, receivedAt])
  @@index([siteId, receivedAt])
  @@index([tenantId])
}

// OpenVPN-primary / Headscale-fallback / Tailscale-legacy gateway
// connectivity tracking (2026-09-03). One row per physical gateway site —
// this build starts with exactly one (the UAE office gateway, LAN IP
// confirmed live as 192.168.11.1 — NOT .20, which appears in stale notes
// from an earlier session and does not respond on either the local LAN or
// from the VPS). `transport` records which path is currently authoritative
// for this site; the migration plan is TAILSCALE (today) -> OPENVPN
// (primary, once its tunnel is proven live end-to-end: ping + a real
// inbound/outbound call + syslog arriving via the tunnel) -> HEADSCALE
// (documented fallback, switched to explicitly, not automatically).
// `tunnelIp` is the deterministic address assigned via the OpenVPN server's
// client-config-dir (server 10.8.0.1, this site's client 10.8.0.10) or
// Headscale's own allocation. No PKI material (CA/cert/key) lives on this
// model or anywhere in Postgres — the OpenVPN server container owns its own
// PKI directory in its named volume; this row only tracks identity and
// observed connectivity state, never secrets.
enum SiteTransport {
  TAILSCALE
  OPENVPN
  HEADSCALE
}

enum SiteConnectivityStatus {
  UNKNOWN
  UP
  DEGRADED
  DOWN
}

model GatewaySite {
  id               String                 @id @default(cuid())
  tenantId         String
  tenant           Tenant                 @relation(fields: [tenantId], references: [id])
  // Stays GLOBALLY unique (plan §1/§4, deliberate) — this is the OpenVPN
  // cert CN and the ccd/ filename; must be globally collision-free across
  // every tenant's gateway, not just within one tenant. Provisioning names
  // it `cust-<slug>-gw-1`.
  name             String                 @unique
  gatewayLanIp     String
  tunnelIp         String?
  transport        SiteTransport          @default(TAILSCALE)
  headscaleNodeKey String?
  lastHandshakeAt  DateTime?
  lastReachableAt  DateTime?
  status           SiteConnectivityStatus @default(UNKNOWN)
  events           GatewayEvent[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([status])
  @@index([tenantId])
}
