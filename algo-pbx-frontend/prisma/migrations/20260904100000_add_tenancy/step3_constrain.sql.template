DROP INDEX "Queue_name_key";
DROP INDEX "DoNotCallEntry_numberE164_key";
DROP INDEX "WaInstance_label_key";
DROP INDEX "WaInstance_simPort_key";
DROP INDEX "Contact_numberE164_key";
