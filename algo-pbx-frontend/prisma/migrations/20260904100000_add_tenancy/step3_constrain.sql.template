-- Multi-tenant SaaS foundation — WAVE 1, STEP 3 of 3 (2026-09-04).
--
-- ***** THIS FILE IS NOT A LIVE MIGRATION YET. *****
-- It is deliberately named "step3_constrain.sql.template", not
-- "migration.sql", and deliberately sits OUTSIDE its own
-- prisma/migrations/<timestamp>_.../ folder. `prisma migrate deploy` only
-- ever executes files literally named "migration.sql" inside a migration
-- folder, so this file is inert until promoted — on purpose, so it can
-- never run before the backfill (step 2) has completed. See
-- migration.sql's header in this same folder for the full three-step
-- rationale.
--
-- PROMOTION STEPS (do this only after rehearse-tenancy-migration.ts reports
-- PASS — zero orphans on every table — and a human has signed off, per the
-- plan's "Working agreement": "Wave 1's gate is owner sign-off after
-- rehearsal evidence"):
--   1. mkdir prisma/migrations/<new-timestamp>_add_tenancy_constrain
--   2. cp step3_constrain.sql.template <that dir>/migration.sql
--   3. Remove this header comment block (or leave it — it's harmless) and
--      run `prisma migrate deploy` for real, with the deploy output
--      confirming the new migration name explicitly (a bare "No pending
--      migrations" is a FAILURE here, not a pass — see LLM.md's repeated
--      lesson on this).
--
-- This step is deliberately the ONLY constraining/destructive half of the
-- three: it asserts zero orphans FIRST (aborting before touching a single
-- constraint if that assertion fails), then does SET NOT NULL, adds every
-- tenantId FK, drops the old single-column unique constraints, creates the
-- new tenant-composite ones, and creates every tenantId index. All pure DDL
-- — no data movement — which is what keeps this transaction short even
-- though it touches ~34 tables.

BEGIN;

-- ---------------------------------------------------------------------
-- Orphan assertion. Any table with a NULL tenantId here means the step 2
-- backfill did not complete (or a new row landed with no tenantId in the
-- window between step 1 and now) — abort before touching any constraint.
-- A row with no tenant is an orphan nobody can ever see again once
-- tenantId is enforced, so this MUST run before a single ALTER below.
-- ---------------------------------------------------------------------
DO $$
DECLARE
  tbl TEXT;
  orphan_count BIGINT;
  bad_tables TEXT := '';
BEGIN
  FOREACH tbl IN ARRAY ARRAY[
    'User', 'OtpChallenge', 'TrustedDevice', 'LoginAttempt', 'Invite',
    'Extension', 'Queue', 'QueueMember', 'CallDetailRecord',
    'DoNotCallEntry', 'Recording', 'AuditLog', 'CallQualitySample',
    'EscalationTarget', 'EscalationAttempt', 'WaInstance', 'Contact',
    'ContactTransferRequest', 'ContactNote', 'ContactTask',
    'CallDisposition', 'Company', 'PipelineStage', 'Deal', 'DealNote',
    'Activity', 'Conversation', 'ChatMessage', 'Room', 'SmsAccessRequest',
    'WebhookSubscription', 'ApiKey', 'GatewayEvent', 'GatewaySite'
    -- NOTE: "AppSetting" is deliberately excluded from this assertion —
    -- its tenantId is nullable BY DESIGN (null = platform default) and is
    -- never SET NOT NULL below.
  ]
  LOOP
    EXECUTE format('SELECT count(*) FROM %I WHERE "tenantId" IS NULL', tbl) INTO orphan_count;
    IF orphan_count > 0 THEN
      bad_tables := bad_tables || format('%s (%s orphans); ', tbl, orphan_count);
    END IF;
  END LOOP;

  IF bad_tables <> '' THEN
    RAISE EXCEPTION 'Tenancy migration step 3 aborted — orphan rows (tenantId IS NULL) found: %. Run scripts/migrate-backfill-tenancy.ts again before retrying.', bad_tables;
  END IF;
END $$;

