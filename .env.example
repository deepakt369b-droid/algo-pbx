# Copy to .env and fill in real values. Never commit .env.
# Referenced by docker-compose.yml and (later) algo-pbx-frontend.

# =========================================================================
# BOOTSTRAP VALUES — required before the app can start at all, or before
# it can read its own settings table. Everything below the "RUNTIME
# SETTINGS" marker further down is now admin-configurable from
# /admin/settings once the app is running (src/lib/settings/) — those
# vars are kept here only as optional seed values / a fallback for
# deployments that never open the settings UI, never required.
# =========================================================================

# --- PostgreSQL ---
POSTGRES_USER=algopbx
POSTGRES_PASSWORD=change-me
POSTGRES_DB=algopbx_db

# --- Runtime settings encryption (src/lib/settings/crypto.ts) ---
# Required before ANY setting can be stored via /admin/settings or the
# first-run /setup wizard — POST /api/setup refuses to create the first
# admin without this being set, with a clear error naming this command.
# Generate with: openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=change-me

# --- Coturn ---
COTURN_REALM=algopbx.local
COTURN_AUTH_SECRET=change-me

# --- Public domain / TLS ---
# The cloud VM's public DNS name, used for WSS signaling and TURN.
VM_PUBLIC_DOMAIN=your-domain.example.com
# Coturn's --external-ip needs both the VM's public IP and its private/NIC
# IP explicitly (cloud VMs sit behind 1:1 NAT) — without this coturn
# advertises the private IP in relay candidates and the TURN fallback
# silently fails. Find these with `curl ifconfig.me` (public) and
# `ip route get 1 | awk '{print $7}'` (private) on the VM itself.
VM_PUBLIC_IP=203.0.113.10
VM_PRIVATE_IP=10.0.0.5

# --- Dinstar GSM Gateway ---
# Currently wired directly to the PBX host's LAN for local call testing
# (192.168.11.0/24) — once the trunk moves to its permanent UAE-office
# location this becomes a Tailscale-reached address instead; update both
# this value and the /admin/dinstar wizard's scan CIDR when that happens.
DINSTAR_LAN_IP=192.168.11.1

# --- Asterisk Manager Interface (AMI) — used by algo-pbx-frontend's API routes ---
# `asterisk` resolves via the host's network_mode:host binding reached through
# the `algo-net` bridge gateway — see pbx_configs/manager.conf for the ACL
# that must match. On the actual VM, use the VM's own LAN/tailscale IP if
# host.docker.internal isn't available on your Docker/OS combination.
AMI_HOST=host.docker.internal
AMI_PORT=5038
AMI_USERNAME=algopbx-app
AMI_SECRET=change-me

# Separate, narrowly-scoped AMI account for scripts/ami-cdr-listener.ts
# ([algopbx-cdr-listener] in manager.conf — read=cdr only). Previously the
# listener shared algopbx-app's full event-class subscription and received
# (then discarded) the entire high-volume `call` event firehose.
CDR_AMI_USERNAME=algopbx-cdr-listener
CDR_AMI_SECRET=change-me

# NOTE: there used to be AGENT_1001_PASSWORD/PHONE_2001_PASSWORD entries
# here — they were never actually read by any code (the seed
# pjsip_dynamic.conf's REPLACE_ME_* values are literal placeholders, not
# env-interpolated) and are doubly obsolete now: as of Phase A, SIP secrets
# are generated server-side per extension (Extension.sipSecret in Postgres)
# when an admin provisions one via /admin/extensions, not sourced from env
# vars at all. See src/lib/pjsip-config.ts and src/app/api/extensions/route.ts.

# --- Next.js frontend (consumed by algo-pbx-frontend once scaffolded) ---
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
NEXT_PUBLIC_SIP_WS_SERVER=wss://${VM_PUBLIC_DOMAIN}:8089/ws
NEXT_PUBLIC_TURN_SERVER=turn:${VM_PUBLIC_DOMAIN}:3478

# --- Auth.js (admin/agent login, src/auth.ts) ---
# Generate with: openssl rand -base64 33
AUTH_SECRET=change-me
AUTH_URL=https://${VM_PUBLIC_DOMAIN}
# Required because Nginx terminates TLS in front of the `web` container
# (see ALGO_PBX_MASTER_DOC.md §4) — Auth.js otherwise can't tell it's being
# reverse-proxied and will reject the request's origin.
AUTH_TRUST_HOST=true

# --- CDR ingestion (server-to-server, POST /api/cdr — see that route's comment) ---
# Generate with: openssl rand -hex 32
CDR_INGEST_SECRET=change-me

# --- Call recordings (src/app/api/recordings/[uniqueid]/route.ts) ---
# In docker-compose this is set directly to /recordings (the container path
# the ./recordings volume is mounted at) — only needed here if running
# `next dev` outside Docker, where it should point at the repo's
# ../recordings directory instead.
RECORDINGS_DIR=/recordings

# --- PJSIP dynamic config (Phase A provisioning, src/lib/pjsip-config.ts) ---
# In docker-compose this is set directly to /pjsip_dynamic.conf (the shared
# bind mount both `web` and `asterisk` see) — only needed here if running
# `next dev` outside Docker, where it should point at
# ../pbx_configs/pjsip_dynamic.conf instead.
PJSIP_DYNAMIC_CONF_PATH=/pjsip_dynamic.conf

# --- Voicemail (Phase E, src/lib/voicemail-config.ts + src/app/api/voicemail) ---
# Same dev-vs-docker-compose split as the two above.
VOICEMAIL_DYNAMIC_CONF_PATH=/voicemail_dynamic.conf
VOICEMAIL_DIR=/voicemail

# =========================================================================
# RUNTIME SETTINGS — everything below is admin-configurable from
# /admin/settings (src/lib/settings/service.ts resolves DB row -> this
# env var -> a registry default, in that order). Leave these blank/unset
# and configure entirely through the UI after first login, or seed them
# here for a fully non-interactive deploy — both work. Editing a value in
# /admin/settings takes effect immediately with no restart; changing it
# here requires a container restart to pick up, same as any other env var.
# =========================================================================

# --- Resend (agent invite emails, src/lib/mail/resend.ts) ---
# https://resend.com/api-keys — used ONLY to deliver the one-time invite
# link an admin generates when creating a user (src/app/api/admin/users).
# There is deliberately no self-service password-reset flow that could
# also use this: agents cannot change their own username or password by
# design, so this key's blast radius if leaked is "someone can send email
# that looks like an invite", not account takeover.
RESEND_API_KEY=change-me
INVITE_FROM_EMAIL=invites@algopbx.local

# --- CRM webhook signing (Workstream G, src/lib/webhooks.ts) ---
# Generate with: openssl rand -hex 32. Recipients verify
# X-AlgoPBX-Signature (HMAC-SHA256 of the raw body) against this shared
# secret before trusting a webhook payload.
CRM_WEBHOOK_SECRET=change-me

# --- OpenWA (WhatsApp engine sidecar, Workstream E) — also the PRIMARY
# OTP delivery channel by default (OTP_CHANNEL below) since it needs no
# Meta template approval and no Firebase project to work at all. ---
# See vendor/openwa/README.md for why this engine was chosen over
# evolution-go, and docker-compose.yml's `openwa` service for how it's
# reached (internal algo-net only, never a published port).
OPENWA_BASE_URL=http://openwa:2785
# Must be >= 32 chars (OpenWA refuses to boot in production otherwise) and
# MUST equal the openwa service's API_MASTER_KEY, which is set from this
# same variable in docker-compose.yml — set it once here.
# Generate with: openssl rand -hex 32
OPENWA_API_MASTER_KEY=change-me-to-a-real-32-plus-char-secret
# HMAC-SHA256 secret the app registers on each WhatsApp session's webhook
# at pairing time (src/lib/messaging/openwa-client.ts). OpenWA has no
# global webhook config to set this on — it is ours, not the sidecar's.
# Generate with: openssl rand -hex 32
OPENWA_WEBHOOK_SECRET=change-me-to-a-real-32-plus-char-secret
OPENWA_ENGINE=baileys

# --- Dinstar UC2000 SMS HTTP/JSON API (Workstream E) ---
# Same gateway/credentials the voice trunk already reaches over Tailscale
# (DINSTAR_LAN_IP above) — its SMS API is a separate HTTP+JSON endpoint on
# the same box, authenticated with the gateway's own admin username/
# password (set on the Dinstar's web UI, not related to any SIP secret).
DINSTAR_SMS_USERNAME=admin
DINSTAR_SMS_PASSWORD=change-me
# Set automatically by the /admin/dinstar setup wizard's probe step — do
# not hand-edit unless you already know which auth style your firmware uses.
DINSTAR_AUTH_STYLE=basic

# Bearer secret for unattended cron polling of inbound Dinstar SMS
# (POST /api/admin/messaging/sms/poll) — the UC2000 has no outbound
# webhook, so without this inbound SMS only arrives when an admin clicks
# "Check for new SMS now". Generate with: openssl rand -hex 32
#
# Crontab line for the VM HOST (not inside a container): `web` is a Docker
# DNS name that only resolves on the algo-net bridge network, so a host
# crontab must go through the published loopback port instead:
#   * * * * * curl -s -X POST -H "Authorization: Bearer $SMS_POLL_SECRET" http://127.0.0.1:3000/api/admin/messaging/sms/poll
SMS_POLL_SECRET=change-me

# Bearer secret for unattended cron pruning of expired recordings/voicemail
# (POST /api/admin/maintenance/prune, Loop D2) — same pattern as
# SMS_POLL_SECRET above. Generate with: openssl rand -hex 32
#
#   0 3 * * * curl -s -X POST -H "Authorization: Bearer $PRUNE_SECRET" http://127.0.0.1:3000/api/admin/maintenance/prune
PRUNE_SECRET=change-me

# --- Meta Cloud API (WhatsApp FALLBACK provider, Workstream E) ---
# Only used when an admin flips a WaInstance's provider, or OTP_CHANNEL
# below, away from OpenWA —
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started.
# Leave blank until needed; the default path (OpenWA) does not require these.
META_WABA_TOKEN=
META_PHONE_NUMBER_ID=

# --- Agent registration: phone OTP verification & login 2FA ---
# OTP_CHANNEL selects which channel sends verification codes for BOTH
# agent registration and login 2FA (src/lib/otp/service.ts). OPENWA
# (default) needs nothing further configured beyond the OpenWA settings
# above and at least one paired, connected WaInstance. OTP_WA_INSTANCE_ID
# optionally pins OTP delivery to one specific paired SIM, isolating its
# ban-risk blast radius from customer WhatsApp traffic — leave blank to
# use the first connected instance automatically.
OTP_CHANNEL=OPENWA
OTP_WA_INSTANCE_ID=

# Firebase Phone Auth is an OPTIONAL third channel (OTP_CHANNEL=FIREBASE)
# — free at this scale (10k verifications/month), no Indian DLT
# registration required since Google is the registered sender, but it
# requires the setup below AND is a client-driven flow (unlike
# OPENWA/META_CLOUD, which are server-driven). Not required to launch;
# leave unset unless you specifically want this channel. Client config is
# NOT secret (identifies the project only); create a Firebase project,
# enable Phone auth, and copy these from Project Settings.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Server-side Firebase Admin credential — the ACTUAL secret, used only by
# src/lib/firebase/admin.ts's verifyIdToken() to confirm a phone
# verification really happened (never trust the client's own claim).
# The full JSON key file's contents, as a single-line string. Generate at
# Firebase Console -> Project Settings -> Service Accounts -> Generate
# new private key.
FIREBASE_SERVICE_ACCOUNT_JSON=

# WhatsApp authentication-category template used for OTP delivery when
# OTP_CHANNEL=META_CLOUD (see src/lib/otp/service.ts). Must be
# pre-approved in the Meta Business Manager before that channel is
# exercised for real; unverified against a live WABA in this codebase.
# Not used when OTP_CHANNEL=OPENWA (the default) — OpenWA sends free-form
# text, no template needed.
WHATSAPP_OTP_TEMPLATE_NAME=agent_otp_verification
WHATSAPP_OTP_TEMPLATE_LANG=en

# --- Agent profile photos (src/lib/agent-photo.ts) ---
# In docker-compose this is set directly to /agent-photos (the container
# path the ./agent-photos volume is mounted at) — only needed here if
# running `next dev` outside Docker.
AGENT_PHOTOS_DIR=/agent-photos
