.env
*.env
.env.local
!.env.example

# Ad-hoc secret dumps (e.g. a session pasting fresh .env values to a scratch
# file mid-VM-repair) — never meant to be committed, but keep them out of
# `git add -A`'s reach entirely rather than relying on every session
# remembering not to stage them.
secrets*.txt
*.secrets.txt

# Local Docker overrides (per-machine ports, etc.)
docker-compose.override.yml

# Asterisk runtime data
recordings/*
!recordings/.gitkeep
voicemail/*
!voicemail/.gitkeep
agent-photos/*
!agent-photos/README.md
pbx_configs/keys/*
!pbx_configs/keys/README.md
pbx_configs/generated/*
!pbx_configs/generated/README.md
# Host-rendered headscale config (scripts/render-headscale-config.sh) —
# same "written by a script from .env, never hand-tracked" convention as
# pbx_configs/generated/ above; contains the real public domain.
pbx_configs/headscale/generated/
# OpenVPN server bridge — requests/ is operational state (empty marker
# files), clients/ contains real .ovpn files with embedded private keys.
# PKI itself (CA/server/client certs+keys) lives in the openvpn_data named
# Docker volume, never here at all — see pbx_configs/openvpn/README.md.
pbx_configs/openvpn/requests/*
pbx_configs/openvpn/clients/*
pbx_configs/openvpn/ccd/*

# Music-on-hold audio — licensing is an operator concern, don't commit media.
# moh/README.md documents provenance and lives OUTSIDE this directory
# deliberately: musiconhold.conf's directory= points straight at
# moh/default/, and Asterisk's `moh show files` was listing README.md
# itself as a playable track (harmless only by luck, since .wav sorted
# first) — see musiconhold.conf's header for the fuller MOH-gaps writeup
# this was fixed alongside.
moh/default/*

# Same reasoning — inbound-call ringtone (see public/sounds/README.md)
algo-pbx-frontend/public/sounds/*
!algo-pbx-frontend/public/sounds/README.md

# Same reasoning — custom Asterisk prompts (see pbx_configs/sounds/README.md)
pbx_configs/sounds/*
!pbx_configs/sounds/README.md

# Postgres/docker volumes (bind-mounted, not tracked)
postgres_data/

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo

# Graphify output (regeneratable)
graphify-out/

# OpenWA upstream source — fetched at the pinned commit by
# vendor/openwa/prepare.sh, never committed (see vendor/openwa/README.md)
vendor/openwa/upstream/

# OS
.DS_Store
Thumbs.db
algo-pbx-frontend/.auth/

# Playwright
algo-pbx-frontend/test-results/
algo-pbx-frontend/playwright-report/
algo-pbx-frontend/e2e/screenshots/
algo-pbx-frontend/blob-report/
algo-pbx-frontend/.last-run.json
